# Vercel -> Project Settings -> Environment Variables වලට මේවා දාන්න
BOT_TOKEN=123456:ABC...            # BotFather දෙන token
BOT_USERNAME=YourBotUsername       # @ නැතිව
SECRET=any-long-random-string      # ඕනෑම දිගු random text එකක්
WEBHOOK_SECRET=another-random-text # webhook ආරක්ෂාවට (a-z, 0-9, _ -)
STORAGE_CHANNEL_ID=-1001234567890  # content ගබඩා කරන private channel ID
ADMIN_IDS=11111111,22222222        # content දාන්න පුළුවන් admin ලාගේ Telegram user ID
SITE_URL=https://your-site.vercel.app   # අන්තිමට / නැතිව
WAIT_STEP1=5                       # config.js එකේ step1.waitSeconds එකට සමාන කරන්න
WAIT_STEP2=3                       # config.js එකේ step2.waitSeconds එකට සමාන කරන්න
PROTECT_CONTENT=0                  # 1 දැම්මොත් forward/save කරන්න බැහැ
